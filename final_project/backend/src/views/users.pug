doctype html
html
  head
    title Users
    link(rel="icon", href="/favicon.ico")
    link(rel="stylesheet", href="/styles.css")
  body
    .container
      h1 Users

      if users.length
        ul
          each user in users
            li
              a(href=`/users/${user.id}`) #{user.login}
      else
        p.empty-message No users found